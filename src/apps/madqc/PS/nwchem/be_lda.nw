title "Be atom GTH-LDA aperiodic"
echo
start be_lda
memory stack 2000 mb heap 2000 mb global 1000 mb

geometry units bohr noautoz nocenter noautosym
  Be 0.00000000000000 0.00000000000000 0.00000000000000
end

nwpw
  simulation_cell
    boundary_conditions aperiodic
    SC 30.0
    ngrid 128 128 128
  end
  xc lda
  mult 1
  lmbfgs
  tolerances 1.0d-9 1.0d-9
end
task pspw energy
