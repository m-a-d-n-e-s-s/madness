                bocc  []         # default   explicit beta occupations (0 or 1) by orbital index within the occupied 
                                 #           span; a 0 is a hole
               nopen  0          # default   number of unpaired electrons = nalpha-nbeta
             maxiter  30         # defined   maximum number of iterations
                 nio  1          # default   no. of io servers to use
     spin_restricted  true       # default   true if spin restricted
              plotlo  0          # default   range of MOs to print (for both spins if polarized
