# DFT linear response validated against DALTON: H2O, PBE0, the alpha diagonal (xx, yy, zz)
# at omega = 0 and 0.05 au. The reference/ values are DALTON's, not a MADNESS run:
# t-aug-cc-pVQZ, where the step from d-aug moves alpha by at most 0.012% (He) /
# 0.006% (H2O). DALTON inputs and output are in dalton_reference/. Phase 3.3 of
# the molresponse plan; the functional definitions match (lda = LDA_X + VWN5 =
# DALTON SVWN5; pbe0 = PBE0).
#
# Run:   ./run.sh          (or: madqc --wf=response response_h2o_pbe0_alpha.in)

dft
    xc        pbe0
    econv     1e-6
    dconv     1e-5
    protocol  [1e-4, 1e-6]
    l         200.0
    localize  new
    maxiter   30
end

response
    dipole              true
    dipole.directions   xyz
    dipole.frequencies  [0.0, 0.05]
    dconv               1e-5
    protocol            [1e-4, 1e-6]
    maxiter             40
    print_level         1
end

molecule
    eprec      1e-6
    units      atomic
    no_orient  true
    O   0.0000000000   0.0000005943   0.1925923500
    H   0.0000000000   1.4214240411  -0.8721230117
    H   0.0000000000  -1.4214246355  -0.8721234678
end
