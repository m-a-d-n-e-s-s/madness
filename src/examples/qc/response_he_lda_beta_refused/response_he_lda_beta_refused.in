# beta on a DFT ground state needs g''_xc, which is not implemented; refused since the f_xc merge
#
# Refusal case: check.json expect_error; no reference. Run: ./run.sh

dft
    xc        lda
    econv     1e-4
    dconv     1e-4
    k         6
    protocol  [1e-4]
    maxiter   20
end

response
    dipole              true
    dipole.directions   z
    dipole.frequencies  [0.0]
    quadratic           true
    dconv               1e-4
end

molecule
    units   atomic
    eprec   1e-6
    He  0.0  0.0  0.0
end
